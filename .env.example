# Copy to .env. Never commit secrets. Requires Python 3.12+.
ASSISTANT_DATABASE_PATH=data/assistant.sqlite3
ASSISTANT_GEMINI_API_KEY=
# Optional ordered chat credentials; keys in the same project share quotas.
ASSISTANT_GEMINI_API_KEYS=
# Pin File Search to its owning project; defaults to the single API key, then first pool key.
ASSISTANT_DOCUMENT_API_KEY=
# Free API quotas vary by model and account; this code does not enable billing.
ASSISTANT_GEMINI_MODEL=gemini-3.5-flash
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_PROVIDER_TIMEOUT_SECONDS=120
ASSISTANT_CONTEXT_TURNS=20
ASSISTANT_CONTEXT_DAYS=7
ASSISTANT_CONTEXT_CHARACTERS=24000
# These are request caps, not a dollar-denominated billing cap.
ASSISTANT_DAILY_TEAM_REQUESTS=200
ASSISTANT_DAILY_USER_REQUESTS=40
ASSISTANT_LOG_LEVEL=INFO
# Settings for this generic installation.
# app.setup generates the bridge token locally. Do not put it in source control.
ASSISTANT_BRIDGE_TOKEN=
ASSISTANT_TEAM_CONFIG_PATH=data/team.json
ASSISTANT_BACKEND_URL=http://127.0.0.1:8000
ASSISTANT_DRIVE_TOKEN_PATH=secrets/google-drive-token.json
ASSISTANT_INCOMING_PATH=data/incoming
ASSISTANT_MAX_UPLOAD_BYTES=26214400
# Managed PDF index; originals remain in Drive. Background sync every two minutes.
ASSISTANT_DOCUMENT_SEARCH_ENABLED=true
ASSISTANT_DOCUMENT_SYNC_SECONDS=120
ASSISTANT_DOCUMENT_MAX_FILES=20
ASSISTANT_DOCUMENT_MAX_TOTAL_BYTES=209715200
ASSISTANT_DOCUMENT_MODEL=gemini-3.5-flash-lite

# Editable identity and project background; live status and permissions live in SQLite.
ASSISTANT_CONTEXT_PATH=context/local
ASSISTANT_CALENDAR_TOKEN_PATH=secrets/google-calendar-token.json
ASSISTANT_DEFAULT_TIMEZONE=UTC
# No-key search keeps this installation free. Gemini grounding is optional, not assumed free.
ASSISTANT_SEARCH_PROVIDER=ddgs
ASSISTANT_SEARCH_MODEL=gemini-2.5-flash
ASSISTANT_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Monday=0, Sunday=6.
ASSISTANT_WEEK_START=0
